DATABASE_URL=postgresql://user:password@localhost:5432/mfa_db
SECRET_KEY=your_jwt_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
TREXO_API_KEY=your_trexo_api_key
TREXO_WEBHOOK_SECRET=your_trexo_webhook_secret
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@mfa.com
SMTP_USE_TLS=True
APP_NAME=MFA Client Management System
DEBUG=True
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","http://localhost:5175"]
IP_HEADER=X-Forwarded-For
